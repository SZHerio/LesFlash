[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/components/game_header.gd" id="1_header"]
[ext_resource type="PackedScene" path="res://ui/components/semantic_icon_button.tscn" id="2_icon_button"]
[ext_resource type="PackedScene" path="res://ui/components/money_amount.tscn" id="3_money"]
[ext_resource type="PackedScene" path="res://ui/components/meta_token.tscn" id="4_meta"]

[node name="GameHeader" type="PanelContainer"]
theme_type_variation = &"ScreenHeaderPanel"
script = ExtResource("1_header")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TopRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Titles" type="VBoxContainer" parent="Content/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="DistrictLabel" type="Label" parent="Content/TopRow/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "ПРИРЕЧНЫЙ РАЙОН"
autowrap_mode = 2

[node name="LocationLabel" type="Label" parent="Content/TopRow/Titles"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LocationTitleLabel"
text = "Вокзальная площадь"
autowrap_mode = 2

[node name="SettingsButton" parent="Content/TopRow" instance=ExtResource("2_icon_button")]
unique_name_in_owner = true
custom_minimum_size = Vector2(48, 48)
layout_mode = 2

[node name="MetaRow" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DatePill" type="PanelContainer" parent="Content/MetaRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PillPanel"

[node name="DateToken" parent="Content/MetaRow/DatePill" instance=ExtResource("4_meta")]
unique_name_in_owner = true
layout_mode = 2

[node name="MoneyPill" type="PanelContainer" parent="Content/MetaRow"]
layout_mode = 2
theme_type_variation = &"PillPanel"

[node name="MoneyAmount" parent="Content/MetaRow/MoneyPill" instance=ExtResource("3_money")]
unique_name_in_owner = true
layout_mode = 2
