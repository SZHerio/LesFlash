[node name="Details" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 4

[node name="ConditionLabel" type="Label" parent="Layout/Details"]
unique_name_in_owner = true
layout_mode = 2
