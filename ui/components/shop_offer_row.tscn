text = "Состояние: 95%"
size_flags_horizontal = 3
autowrap_mode = 2

[node name="QualityLabel" type="Label" parent="Layout/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MetaLabel"
text = "Качество: 70%"
size_flags_horizontal = 3
horizontal_alignment = 2
autowrap_mode = 2

[node name="Divider" type="HSeparator" parent="Layout"]
layout_mode = 2

[node name="QuantityTitle" type="Label" parent="Layout"]
