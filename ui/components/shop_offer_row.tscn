custom_minimum_size = Vector2(32, 32)
layout_mode = 2
size_flags_vertical = 4

[node name="IdentityCopy" type="VBoxContainer" parent="Layout/Identity"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="Layout/Identity/IdentityCopy"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ActionTitleLabel"
text = "Буханка ржаного хлеба"
autowrap_mode = 2

[node name="StockLabel" type="Label" parent="Layout/Identity/IdentityCopy"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "4 штуки"
autowrap_mode = 2

[node name="UnitPricePanel" type="PanelContainer" parent="Layout/Identity"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"PillPanel"

[node name="UnitPrice" parent="Layout/Identity/UnitPricePanel" instance=ExtResource("3_money")]
