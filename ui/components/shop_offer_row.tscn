[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/components/shop_offer_row.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/semantic_icon.tscn" id="2_icon"]
[ext_resource type="PackedScene" path="res://ui/components/money_amount.tscn" id="3_money"]

[node name="ShopOfferRow" type="PanelContainer"]
size_flags_horizontal = 3
theme_type_variation = &"SurfaceCard"
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Identity" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ItemIcon" parent="Layout/Identity" instance=ExtResource("2_icon")]
