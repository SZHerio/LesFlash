autowrap_mode = 2

[node name="ContentPanel" type="PanelContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"SurfaceCard"

[node name="Scroll" type="ScrollContainer" parent="Layout/ContentPanel"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Layout/ContentPanel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Subtitle" type="Label" parent="Layout/ContentPanel/Scroll/Body"]
