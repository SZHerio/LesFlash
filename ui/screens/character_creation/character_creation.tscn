[node name="PointsRow" type="HBoxContainer" parent="Layout/ContentPanel/Scroll/Body"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Caption" type="Label" parent="Layout/ContentPanel/Scroll/Body/PointsRow"]
